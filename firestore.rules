rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isExistingOwner(userId) {
      return isOwner(userId) && resource != null;
    }

    function clientDataMatchesPathOnCreate(clientId) {
      return request.resource.data.id == clientId;
    }

    function clientIdIsImmutable() {
      return request.resource.data.id == resource.data.id;
    }

    match /admins/{uid} {
      allow read: if isOwner(uid);
      allow write: if false;
    }

    match /clients/{clientId} {
      allow get: if isOwner(clientId);
      allow list: if false;

      allow create: if isOwner(clientId) && clientDataMatchesPathOnCreate(clientId);
      allow update: if isExistingOwner(clientId) && clientIdIsImmutable();
      allow delete: if isExistingOwner(clientId);

      // API-only
      match /reviews/{reviewId} {
        allow read, write: if false;
      }

      // API-only
      match /locations/{locationId} {
        allow read, write: if false;
      }

      match /notifications/{notificationId} {
        allow get, list: if isOwner(clientId);
        allow create: if isOwner(clientId);
        allow update, delete: if isExistingOwner(clientId);
      }
    }

    match /credit_transactions/{transactionId} {
      allow get: if isSignedIn() && resource.data.clientId == request.auth.uid;
      allow list: if false;
      allow create: if isSignedIn() && request.resource.data.clientId == request.auth.uid;
      allow update, delete: if false;
    }
  }
}
